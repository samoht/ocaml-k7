; The emulator, the tape lexer and the Unicode tables are private to the
; library; their properties compile them in.

(copy_files
 ../lib/{screen,tape_syntax,regexp_syntax,unicode,unicode_data}.{ml,mli})

(executable
 (name fuzz)
 (flags
  (:standard -open Matrix_backport))
 (libraries
  vhs
  vhs_cram
  svg_check
  matrix_backport
  fmt
  alcobar
  eio
  eio_main
  unix))

; The property run is a quick smoke. The oracle alias also runs the
; properties that need the real vhs (VHS_ORACLE), for longer.

(rule
 (alias runtest)
 (enabled_if
  (<> %{profile} afl))
 (action
  (setenv
   VHS_CRAM_TEST_EXE
   %{bin:vhs-cram}
   (run %{exe:fuzz.exe} --budget 0.2 --timeout 60 --seed 42))))

(rule
 (alias oracle)
 (enabled_if
  (<> %{profile} afl))
 (action
  (setenv
   VHS_CRAM_TEST_EXE
   %{bin:vhs-cram}
   (setenv
    VHS_ORACLE
    vhs
    (run %{exe:fuzz.exe} --budget 5 --timeout 120)))))

(rule
 (alias fuzz)
 (enabled_if
  (= %{profile} afl))
 (action
  (progn
   (run %{exe:fuzz.exe} --gen-corpus corpus)
   (run afl-fuzz -V 60 -i corpus -o _fuzz -- %{exe:fuzz.exe} @@))))
