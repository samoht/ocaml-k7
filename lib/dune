;; The case folding orbits and the Unicode tables of Go, as OCaml strings.

(rule
 (targets casefold_data.ml)
 (deps casefold.txt)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "let table = {|")
    (cat casefold.txt)
    (echo "|}\n")))))

(rule
 (targets unicode_data.ml)
 (deps unicode.txt)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "let table = {|")
    (cat unicode.txt)
    (echo "|}\n")))))

(mdx
 (package vhs)
 (files vhs.mli)
 (libraries vhs))
