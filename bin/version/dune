; dune-build-info installs no .cmx for its data module, which dune replaces at
; link time, so flambda raises warning 58 on every use (ocaml/dune#11418).

(library
 (name version)
 (flags
  (:standard -w -58))
 (libraries dune-build-info))

(rule
 (target project_version.ml)
 (deps
  (env_var PROJECT_VERSION))
 (action
  (with-stdout-to
   %{target}
   (bash "printf 'let env = \"%s\"\\n' \"${PROJECT_VERSION:-dev}\""))))
