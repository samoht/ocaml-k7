; The library is private: it keeps the cram translation and the command line
; testable without making them part of the installed vhs library. Its
; messages quote strings as the library's do.

(copy_files ../lib/quote.{ml,mli})

(library
 (name vhs_cram)
 (modules cram cli quote)
 (libraries vhs cmdliner eio eio.unix eio_main fmt unix))

(executable
 (name main)
 (public_name vhs-cram)
 (package vhs)
 (modules main)
 (libraries vhs_cram cmdliner))
