# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Generate and run VHS terminal tapes, or record them as SVG without VHS"
description:
  "Build VHS terminal recordings as OCaml values, check them against VHS's own parser rules before VHS runs, print them as .tape files and run vhs on them to record a GIF or a video. A native recorder plays a tape in bash, zsh or fish on a pseudo-terminal and draws an SVG image animated with CSS alone, with no vhs, browser or ffmpeg. The vhs-cram command records a cram test either way."
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["command-line-utilities" "format" "eio"]
homepage: "https://github.com/samoht/ocaml-vhs"
bug-reports: "https://github.com/samoht/ocaml-vhs/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.4"}
  "eio" {>= "1.6"}
  "eio_main" {>= "1.6"}
  "fmt" {>= "0.8.7"}
  "cmdliner" {>= "2.0.0"}
  "alcotest" {with-test}
  "mtime" {>= "2.0.0"}
  "cstruct" {>= "6.0.1"}
  "matrix" {>= "0.1.0" & < "0.2.0"}
  "re" {>= "1.10.0"}
  "jsont" {>= "0.4.0"}
  "bytesrw" {>= "0.1.0"}
  "markup" {>= "1.0.0" & with-test}
  "alcobar" {with-test & >= "0.3.2"}
  "mdx" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-vhs.git"
x-maintenance-intent: ["(latest)"]
