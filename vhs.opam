# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Generate and run Charmbracelet VHS terminal tapes"
description:
  "Build VHS terminal recordings as OCaml values, check them against VHS's own parser rules before VHS runs, print them as .tape files and run vhs on them. The vhs-cram command records a cram test."
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["command-line-utilities" "format" "eio"]
homepage: "https://github.com/samoht/ocaml-vhs"
bug-reports: "https://github.com/samoht/ocaml-vhs/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "eio" {>= "1.4"}
  "eio_main" {>= "1.4"}
  "fmt"
  "cmdliner" {>= "2.0.0"}
  "alcotest" {with-test}
  "cstruct" {with-test}
  "alcobar" {with-test}
  "mdx" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-vhs.git"
x-maintenance-intent: ["(latest)"]
