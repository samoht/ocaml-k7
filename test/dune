; Compile the exact CLI functions, omitting only the process-wide exit.
(rule
 (targets vhs_cram_subject.ml)
 (deps ../bin/vhs_cram.ml)
 (action
  (with-stdout-to %{targets}
   (run sed "/^let () = exit /d" %{deps}))))

(cram
 (deps %{bin:vhs-cram}))
