; The oracle alias also runs the tests that record with the real vhs.

(rule
 (alias oracle)
 (deps
  regexp_cases.txt
  tape_cases.txt
  number_cases.txt
  theme_cases.txt
  match_cases.txt)
 (action
  (setenv
   VHS_ORACLE
   vhs
   (run %{exe:test.exe}))))

(cram
 (deps %{bin:vhs-cram}))
