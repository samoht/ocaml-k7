; The emulator and the pattern matcher are private to the library; their
; tests compile them in.

(copy_files
 ../lib/{screen,casefold,casefold_data,unicode,unicode_data,regexp_match}.{ml,mli})

(test
 (name test)
 (deps
  regexp_cases.txt
  tape_cases.txt
  number_cases.txt
  theme_cases.txt
  match_cases.txt)
 (libraries
  vhs
  vhs_cram
  svg_check
  matrix.ansi
  matrix.glyph
  matrix.grid
  matrix.vte
  native_test
  fmt
  alcotest
  cstruct
  eio
  eio.unix
  eio_main
  eio.mock
  mtime
  cmdliner
  unix))

; The oracle alias also runs the tests that record with the real vhs.

(rule
 (alias oracle)
 (deps
  regexp_cases.txt
  tape_cases.txt
  number_cases.txt
  theme_cases.txt
  match_cases.txt)
 (action
  (setenv
   VHS_ORACLE
   vhs
   (run %{exe:test.exe}))))

(cram
 (deps %{bin:vhs-cram}))
