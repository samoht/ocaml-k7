build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test & os != "macos" & os != "win32"}
    "@doc" {with-doc}
  ]
]
pin-depends: [
  ["matrix.0.2.0+keeper" "git+https://github.com/invariant-hq/mosaic.git#8a7a0b75cce9524d261b90561721698aa26c3ccf"]
]
